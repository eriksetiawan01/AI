    {
      "parameters": {
        "sendTo": "={{ $('Webhook').item.json.query.email }}",
        "subject": "Pengajuan Cuti DISETUJUI",
        "message": "=<div style=\"font-family: 'Segoe UI', Helvetica, Arial, sans-serif; max-width: 600px; margin: 0 auto; padding: 25px; border: 1px solid #e5e7eb; border-radius: 12px; background-color: #ffffff;\">\n    \n    <div style=\"text-align: center; margin-bottom: 20px;\">\n        <span style=\"background-color: #f0fdf4; color: #16a34a; font-weight: bold; padding: 6px 16px; border-radius: 9999px; font-size: 14px;\">✓ APPROVED</span>\n    </div>\n    \n    <h3 style=\"color: #1f2937; margin-top: 0; margin-bottom: 8px;\">Halo, {{ $('Webhook').item.json.query.nama }}</h3>\n    <p style=\"color: #4b5563; font-size: 15px; line-height: 1.6; margin-bottom: 20px;\">\n        Kabar baik! Pengajuan cuti Anda telah <strong>disetujui</strong> oleh Manager. Berikut adalah rincian lengkap pengajuan Anda:\n    </p>\n\n    <table style=\"width: 100%; border-collapse: collapse; margin-bottom: 25px; font-size: 15px;\">\n        <tr>\n            <td style=\"width: 140px; color: #6b7280; padding: 8px 0; vertical-align: top;\">Jenis Cuti</td>\n            <td style=\"width: 15px; color: #6b7280; padding: 8px 0; text-align: center; vertical-align: top;\">:</td>\n            <td style=\"color: #1f2937; padding: 8px 0; font-weight: 500;\">{{ $('Webhook').item.json.query.jenis_cuti }}</td>\n        </tr>\n        <tr>\n            <td style=\"color: #6b7280; padding: 8px 0; vertical-align: top;\">Tanggal Cuti</td>\n            <td style=\"color: #6b7280; padding: 8px 0; text-align: center; vertical-align: top;\">:</td>\n            <td style=\"color: #1f2937; padding: 8px 0; font-weight: 500;\">\n                {{ $('Webhook').item.json.query.start_date }} s.d {{ $('Webhook').item.json.query.end_date }}\n            </td>\n        </tr>\n        <tr>\n            <td style=\"color: #6b7280; padding: 8px 0; vertical-align: top;\">Durasi</td>\n            <td style=\"color: #6b7280; padding: 8px 0; text-align: center; vertical-align: top;\">:</td>\n            <td style=\"color: #1f2937; padding: 8px 0; font-weight: bold;\">{{ $('Webhook').item.json.query.days }} Hari</td>\n        </tr>\n        <tr>\n            <td style=\"color: #6b7280; padding: 8px 0; vertical-align: top;\">Alasan</td>\n            <td style=\"color: #6b7280; padding: 8px 0; text-align: center; vertical-align: top;\">:</td>\n            <td style=\"color: #4b5563; padding: 8px 0; font-style: italic;\">\"{{ $('Webhook').item.json.query.alasan }}\"</td>\n        </tr>\n        <tr>\n            <td style=\"color: #6b7280; padding: 8px 0; vertical-align: top;\">Status Persetujuan</td>\n            <td style=\"color: #6b7280; padding: 8px 0; text-align: center; vertical-align: top;\">:</td>\n            <td style=\"color: #16a34a; padding: 8px 0; font-weight: bold;\">DISETUJUI (APPROVED)</td>\n        </tr>\n        <tr>\n            <td style=\"color: #6b7280; padding: 8px 0; vertical-align: top;\">Saldo Cuti</td>\n            <td style=\"color: #6b7280; padding: 8px 0; text-align: center; vertical-align: top;\">:</td>\n            <td style=\"color: #6b7280; padding: 8px 0; font-size: 14px;\">Telah dipotong otomatis oleh sistem</td>\n        </tr>\n    </table>\n\n    <p style=\"color: #4b5563; font-size: 14px; line-height: 1.6; border-top: 1px solid #f3f4f6; padding-top: 15px; margin-bottom: 0;\">\n        Selamat beristirahat! Mohon pastikan delegasi tugas Anda telah dikoordinasikan dengan baik bersama tim sebelum cuti dimulai.\n    </p>\n    \n    <div style=\"margin-top: 30px; font-size: 12px; color: #9ca3af; text-align: center;\">\n        Sistem Otomatis HR\n    </div>\n</div>",
        "options": {
          "appendAttribution": false
        }
