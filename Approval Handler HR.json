    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "=<!DOCTYPE html>\n<html lang=\"id\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Persetujuan Cuti Berhasil</title>\n    <script src=\"https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4\"></script>\n</head>\n<body class=\"bg-gray-50 flex items-center justify-center min-h-screen font-sans\">\n\n    <div class=\"bg-white p-8 rounded-2xl shadow-xl max-w-md w-full text-center border border-gray-100\">\n        <div class=\"mx-auto flex items-center justify-center h-16 w-16 rounded-full bg-green-50 mb-6\">\n            <svg class=\"h-10 w-10 text-green-500\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 13l4 4L19 7\"></path>\n            </svg>\n        </div>\n\n        <h2 class=\"text-2xl font-bold text-gray-800 mb-2\">Persetujuan Berhasil!</h2>\n        \n        <p class=\"text-gray-600 mb-6 leading-relaxed\">\n            Pengajuan cuti karyawan telah <span class=\"text-green-600 font-semibold\">disetujui</span> dan saldo telah diperbarui secara otomatis oleh sistem.\n        </p>\n\n        <div class=\"border-t border-gray-100 my-4\"></div>\n\n        <p class=\"text-xs text-gray-400\">\n            Sistem Otomatis HR\n        </p>\n    </div>\n\n</body>\n</html>",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "text/html"
              }
            ]
          }
        }
      },
